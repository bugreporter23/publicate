#!/usr/bin/env bash
set -euo pipefail

main() {
    project=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
    cd -- "$project"
    publicate_flake=${PUBLICATE_FLAKE:-.#publicate}

    if [[ ${1:-} == --help ]]; then
        printf '%s\n' 'Interactive publication using publicate.toml and a Publicate Nix app.' \
            'Requires Bash, Git and Nix with flakes; verified builds require Linux user/mount namespaces.' \
            'Build verification follows build.verify; --verify-build requests it explicitly.' \
            'PUBLICATE_FLAKE selects the app (default: .#publicate).' \
            'Publication also pushes the current private branch to its own origin.' \
            'Select the exact release in publicate.toml [publish] version.' \
            'Application version_file must agree with the configured release.' \
            'Declining publication verifies the candidate without changing refs.' \
            'Cleanup retains five snapshots per major/minor line by default.'
        exit 0
    fi
    verification=()
    if [[ $# == 1 && $1 == --verify-build ]]; then
        verification+=(--verify-build)
    elif [[ $# != 0 ]]; then
        printf '%s\n' 'Usage: ./publicate/publish.sh [--help|--verify-build]' >&2
        exit 1
    fi

    nix run "$publicate_flake" -- --policy "$project/publicate.toml" diff
    nix run "$publicate_flake" -- --policy "$project/publicate.toml" versions
    read -r -p 'Publish the release and push the current private branch? [y/N] ' publish
    options=()
    case "$publish" in
        y|Y|yes|YES)
            options+=(--push)
            private_branch=$(git symbolic-ref --quiet --short HEAD)
            git remote get-url origin > /dev/null
            ;;
        ''|n|N|no|NO) ;;
        *) printf '%s\n' 'Choose yes or no.' >&2; exit 1 ;;
    esac

    nix run "$publicate_flake" -- --policy "$project/publicate.toml" release "${verification[@]}" "${options[@]}"
    if [[ ${#options[@]} -gt 0 ]]; then
        nix run "$publicate_flake" -- --policy "$project/publicate.toml" prune --keep-patches "${PUBLICATE_KEEP_PATCHES:-5}" --push
        printf 'Pushing private branch %s to its origin.\n' "$private_branch"
        git push --no-follow-tags origin "refs/heads/$private_branch:refs/heads/$private_branch"
    fi
}

main "$@"; exit
